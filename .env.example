GEMINI_API_KEY=replace_with_your_server_side_key
# gemini-3.8-flash is the fast flagship default. Free-tier keys can be capped
# (for example 20 requests/day), which returns HTTP 429 "rate limit exceeded".
#
# IMPORTANT: Google meters the free tier PER MODEL, so exhausting one model
# does not mean the key is spent. GEMINI_MODELS is the rotation list the
# server walks: on a 429 or 404 it marks that slug spent and moves to the
# next one, which multiplies your usable free quota without another key.
#
# These were verified to accept PDF input on the same key. Keep them in
# this order — fastest and best-quality first.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.5-flash,gemini-pro-latest,gemini-flash-latest

# Legacy single-model setting. Still honoured when GEMINI_MODELS is
# absent, so an older .env keeps working unchanged.
GEMINI_MODEL=gemini-3.8-flash
PORT=4173

# ---------- Additional AI providers (optional, free tiers) ----------
# Requests walk this pool in order and move to the NEXT provider whenever
# one returns 429/5xx or the network drops. Adding a key needs no code
# change — just add it here and restart.
#
# PDF uploads (/api/analyze) run ONLY on providers marked document-capable,
# which today means Gemini alone: the others cannot read a PDF, and routing
# one there would return a fluent but completely fabricated study pack.
# AURA and /api/ask are text-only and use every configured provider.
#
# Groq — free plan is roughly 1,000 requests/day, about 50x a free Gemini
# key, and needs no credit card. Sign up at console.groq.com.
# Check which models your key can actually reach with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Models get retired, so verify the name there if chat calls start failing
# with 404. llama-3.3-70b-versatile was decommissioned and is no longer valid.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# xAI Grok — text only (AURA and /api/ask). READ THIS BEFORE ENABLING.
#
# xAI has NO free tier. It bills from prepaid credits, so this provider
# SPENDS MONEY on every call while Gemini and Groq are free. It is listed
# because Grok often writes the densest, most accurate study copy — not
# because it is cheaper. It is the opposite.
#
# Reference pricing (grok-4.7, under the 200k context threshold):
#   input $2.00 / 1M tokens, output $6.00 / 1M tokens.
# One PDF study pack is tens of thousands of input tokens plus a long JSON
# output, so a single PDF lands around cents. Fine occasionally; not
# something to drive through the retry loop.
#
# Why Grok is marked documents:false even though it CAN read PDFs:
#   · PDFs must use the Files API (upload, then send a file_id). Inline
#     base64 is not accepted, so /api/analyze needs a real upload path.
#   · Attaching a file makes the request agentic: xAI converts it into a
#     document-search workflow and documents it as costing extra tokens.
#   · Stored files are billed per GiB/day, and downloads are billed too.
# Text-only use avoids all of those.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# OpenRouter — free models carry a low per-day cap and are documented as not
# production-ready. Kept last so it is only reached once the others are out.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Experiential Labs — OpenAI-compatible gateway over ~1,000 models at
# https://platform.experientiallabs.ai. It is CREDIT-BASED, not a free
# tier: platform-funded calls draw down a balance you must top up, and
# calls made with your own provider key (BYOK) are billed to you
# directly by that provider. Mint a key at
# https://platform.experientiallabs.ai/api-keys (key starts with xpl_).
#
# It is document-capable here, so it can serve PDF analysis too — but it
# sits AFTER gemini in the pool, so Gemini still leads and this only
# catches the case where Gemini is rate-limited or down.
#
# EXPLABS_MODEL must be a slug from their catalog that accepts PDF/file
# input. Browse them at platform.experientiallabs.ai/models and confirm
# with:
#   curl https://api.experientiallabs.ai/v1/models -H "Authorization: Bearer $EXPLABS_API_KEY"
# A text-only slug will return HTTP 400 on a PDF upload.
EXPLABS_API_KEY=
EXPLABS_MODEL=gemini-3.8-flash

# Run GET /api/providers to see which keys were picked up and the live
# failover order. It reports only whether a key exists, never the key itself.

# ---------- Cloud hosting (Render / Koyeb / Fly.io) ----------
# Set NODE_ENV=production in your host's dashboard. This is what makes the
# server bind 0.0.0.0 instead of 127.0.0.1 — without it the host cannot
# route traffic to the process and every request times out.
NODE_ENV=production

# Set this ONLY when exactly one trusted proxy sits in front (all the hosts
# above do this). It makes the rate limiter read the real client IP from
# X-Forwarded-For. Leave it false for direct/local runs: with nothing
# proxying, a client could send that header itself and bypass the limit.
TRUST_PROXY=true

# AI requests allowed per IP per hour (1-60).
# PDF generations allowed per caller per day. Google allows 20 free
# generations per model per day, and each entry in GEMINI_MODELS is a
# separate bucket, so this list is what makes capacity large. The cap
# stops one person draining the whole pool.
# Keyed on client IP, NOT on account: accounts in js/auth.js live in
# localStorage with no server check, so a browser-supplied user id could
# be forged. Everyone behind one NAT or campus network shares an
# allowance. Set to 0 to disable the cap.
PDF_GENERATIONS_PER_DAY=5
MAX_REQUESTS_PER_HOUR=60
# Largest accepted PDF, in megabytes. The client dropzone label is fixed at
# 20 MB, so keep these in step if you change this value.
MAX_PDF_MB=20

# ---------- Unit-by-unit builds for large PDFs ----------
# Above UNIT_SPLIT_MB the job no longer asks one call for the whole book:
# it plans the real units, delivers Unit 1 immediately (stored straight
# into the user's library) and keeps building Units 2..N in the background,
# each unlocking on the plan page while Unit 1 is already being studied.
# Small files keep the original single-shot path. Set to 0 to force every
# file through the chunked path (useful for testing).
UNIT_SPLIT_MB=8
# Gemini caps one request at 20 MB and base64 inflates a PDF by 4/3, so
# raw files above ~14 MB cannot ride inlineData. Above GEMINI_INLINE_MB
# the server uploads the PDF once through the Gemini Files API and every
# stage call references the stored file. Lower this if a provider starts
# rejecting inline documents near the cap.
GEMINI_INLINE_MB=14
