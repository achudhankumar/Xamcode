        },
        {
          "title": "Phase B",
          "desc": "தரவு பரிமாற்றம் (Transmission)"
        },
        {
          "title": "Phase C",
          "desc": "ஒப்புதல் சரிபார்ப்பு (Acknowledgement)"
        }
      ]
    },
