GEMINI_API_KEY=AQ.Ab8RN6LVYBnQyxGn-bO6Lzcc8SKT7xC3cqwkyBQhKkdflgqTkw
# gemini-3.8-flash is capped at 20 requests/day on the free tier and is currently exhausted.
# gemini-3.5-flash works with this key (verified end-to-end) but is slower (~2 min per study).# Rotation list for PDF analysis. Google meters the free tier per
# model, so on a 429 or 404 the server marks that slug spent and tries
# the next one. Verified to accept PDF input on this key.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.5-flash,gemini-pro-latest,gemini-flash-latest
# Legacy single-model setting; used only if GEMINI_MODELS is absent.
GEMINI_MODEL=gemini-3.8-flash
PORT=4173
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# PDF generations allowed per caller per day, so one person cannot
# drain the shared free-tier pool. Keyed on client IP, not account:
# accounts in js/auth.js are localStorage-only with no server check.
# Set to 0 to disable.
PDF_GENERATIONS_PER_DAY=5